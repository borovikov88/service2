# Django
SECRET_KEY=
ALLOWED_HOSTS=
ADVISOR_MCP_TEST_ENABLED=false
# Comma-separated exact browser origins; leave empty for server-to-server probe calls.
ADVISOR_MCP_TEST_ALLOWED_ORIGINS=
# Protected remote MCP for ChatGPT financial adviser.  Keep disabled until a
# public OAuth client with the exact HTTPS callback URI is provisioned in the
# production DB.  Values below are non-secret endpoint configuration only.
ADVISOR_FINANCE_MCP_ENABLED=false
# Comma-separated exact browser Origin allowlist. A present unlisted Origin
# gets 403; missing Origin is allowed for ChatGPT's server-side transport.
ADVISOR_FINANCE_MCP_ALLOWED_ORIGINS=https://chatgpt.com
# Canonical public endpoint, e.g. https://service2.example.ru/mcp/finance
ADVISOR_FINANCE_MCP_RESOURCE_URL=
# OAuth issuer on the same public HTTPS origin, e.g. https://service2.example.ru
ADVISOR_FINANCE_MCP_AUTH_ISSUER=
ADVISOR_FINANCE_MCP_ACCESS_TOKEN_TTL_SECONDS=600
ADVISOR_FINANCE_MCP_REFRESH_TOKEN_TTL_SECONDS=2592000
ADVISOR_FINANCE_MCP_AUTHORIZATION_CODE_TTL_SECONDS=300
SITE_URL=

# Dedicated local MySQL database only
DB_ENGINE=django.db.backends.mysql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional email configuration
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=

# Optional integrations
SMS_RU_API_ID=
VAPID_EMAIL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
YANDEX_SUGGEST_API_KEY=

# Optional OpenAI integration for DevelopmentTask primary analysis
OPENAI_API_KEY=
OPENAI_DEVELOPMENT_MODEL=gpt-5.6
OPENAI_DEVELOPMENT_TIMEOUT_SECONDS=25
OPENAI_DEVELOPMENT_MAX_OUTPUT_TOKENS=6000

# Optional GitHub Actions integration for DevelopmentTask Codex execution
GITHUB_DEVELOPMENT_TOKEN=
GITHUB_DEVELOPMENT_REVIEW_TOKEN=
GITHUB_DEVELOPMENT_REVIEW_LOGIN=
GITHUB_DEVELOPMENT_AUTO_MERGE_ENABLED=false
GITHUB_DEVELOPMENT_REPOSITORY=borovikov88/service2
GITHUB_DEVELOPMENT_WORKFLOW=development-codex.yml
GITHUB_DEVELOPMENT_TIMEOUT_SECONDS=20
GITHUB_DEVELOPMENT_PROMPT_MAX_BYTES=40000

# Optional read-only 1C Fresh OData gross-profit preview
# The URL must not contain credentials and must end with /odata/standard.odata/
ONEC_ODATA_BASE_URL=
ONEC_ODATA_USERNAME=
ONEC_ODATA_PASSWORD=
# Comma-separated 1C organization GUID allowlist
ONEC_ODATA_ORGANIZATION_GUIDS=
ONEC_ODATA_TARGET_ORGANIZATION_ID=
ONEC_ODATA_TIMEOUT_SECONDS=15
ONEC_ODATA_MAX_PAGES=100
ONEC_ODATA_MAX_ROWS=100000
# Calendar time passed to 1C Balance(Period=...). Do not inherit server/browser timezone.
ONEC_ODATA_CALENDAR_TIMEZONE=Asia/Barnaul
# Finance-position snapshot older than this is reported stale.
ONEC_FINANCE_POSITION_STALE_HOURS=26

# Валюта начислений ФОТ: GUID из проверенной 1С, обязательна для импорта.
ONEC_ODATA_PAYROLL_CURRENCY_GUID=

# Укажите RUB только после проверки, что GUID выше обозначает российский рубль.
ONEC_ODATA_PAYROLL_CURRENCY_CODE=

# Explicit acceptance of payroll source coverage for automatic application.
# Copy the verified ONEC_ODATA_ORGANIZATION_GUIDS set, including orgs without rows.
ONEC_ODATA_PAYROLL_AUTO_COVERAGE_GUIDS=
# Enable only after sync_onec_finance --check and installation of the cron tick.
ONEC_FINANCE_DAILY_ENABLED=false
# Existing service2 user with current import rights for all three reports.
ONEC_FINANCE_SYNC_USER_ID=
ONEC_FINANCE_DAILY_TIME=06:00
ONEC_FINANCE_TIME_ZONE=Asia/Barnaul
ONEC_FINANCE_LOOKBACK_MONTHS=3

# Explicitly verified individual withholding catalog GUIDs; empty rejects deductions.
ONEC_ODATA_PAYROLL_WITHHOLDING_GUIDS=
